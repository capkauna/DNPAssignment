@page "/userregistration"
@using DTOs
@using BlazorApp.Services
@inject IUserService UserService
@inject NavigationManager navigationManager

@rendermode InteractiveServer

<PageTitle>Register New User</PageTitle>

<div class="container mx-auto p-4 max-w-lg">
    <h1 class="text-3xl font-bold mb-6 text-indigo-700">Register New User</h1>

    <!-- Registration Form -->
    <div class="bg-white shadow-xl rounded-xl p-8 border-t-4 border-indigo-500">

        <EditForm Model="@createUserDto" OnValidSubmit="HandleRegistration" FormName="RegistrationForm">
            <DataAnnotationsValidator />

            @* Success Message *@
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
                    <span class="block sm:inline">@successMessage</span>
                </div>
            }

            @* Error Message *@
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
                    <span class="block sm:inline">@errorMessage</span>
                </div>
            }

            <div class="mb-4">
                <label for="username" class="block text-sm font-medium text-gray-700">Username</label>
                <InputText id="username" @bind-Value="createUserDto.UserName" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm p-2 border" />
                <ValidationMessage For="@(() => createUserDto.UserName)" class="text-red-500 text-xs" />
            </div>

            <div class="mb-6">
                <label for="password" class="block text-sm font-medium text-gray-700">Password</label>
                <InputText id="password" type="password" @bind-Value="createUserDto.Password" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm p-2 border" />
                <ValidationMessage For="@(() => createUserDto.Password)" class="text-red-500 text-xs" />
            </div>

            <button type="submit" disabled="@isSubmitting" class="w-full inline-flex justify-center py-3 px-4 border border-transparent shadow-sm text-base font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 disabled:bg-indigo-300">
                @if (isSubmitting)
                {
                    <span class="animate-spin mr-2">⟳</span>
                    <span>Registering...</span>
                }
                else
                {
                    <span>Register Account</span>
                }
            </button>
        </EditForm>
    </div>
</div>

@code {
    private CreateUserDto createUserDto = new();
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isSubmitting = false;

    private async Task HandleRegistration()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;
        isSubmitting = true;

        try
        {
            // Call the service method, which makes the HTTP POST request
            var registeredUser = await UserService.AddUserAsync(createUserDto);

            // Success!
            successMessage = $"Successfully registered user: {registeredUser.UserName} (ID: {registeredUser.Id})!";

            // Clear the form data
            createUserDto = new CreateUserDto();

            // Optional: Wait a moment and redirect
            await Task.Delay(2000);
            navigationManager.NavigateTo("/feed");
        }
        catch (Exception ex)
        {
            // Display error message from the API or network failure
            errorMessage = $"Registration failed: {ex.Message}";
            Console.WriteLine(ex.Message); // Log the full error to the console
        }
        finally
        {
            isSubmitting = false;
        }
    }
}